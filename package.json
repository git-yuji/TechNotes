{
  "name": "tech-notes",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "upload": "opennextjs-cloudflare build && opennextjs-cloudflare upload",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv ./cloudflare-env.d.ts",
    "db:migrate:local": "wrangler d1 migrations apply tech-notes-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply tech-notes-db --remote",
    "db:seed:local": "wrangler d1 execute tech-notes-db --local --file=./seeds/seed.sql",
    "db:seed:remote": "wrangler d1 execute tech-notes-db --remote --file=./seeds/seed.sql",
    "notes:sync:local": "node scripts/sync-notes.mjs",
    "notes:sync:remote": "node scripts/sync-notes.mjs --remote"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "^1.19.9",
    "next": "16.2.11",
    "react": "^19.1.7",
    "react-dom": "^19.1.7",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20.19.43",
    "@types/react": "^19.1.7",
    "@types/react-dom": "^19.1.7",
    "eslint": "^9",
    "eslint-config-next": "16.2.11",
    "tailwindcss": "^4",
    "typescript": "^5.7.4",
    "wrangler": "^4.115.0"
  }
}
