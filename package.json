{
  "name": "tech-notes",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "postinstall": "node scripts/generate-notes.mjs",
    "predev": "node scripts/generate-notes.mjs",
    "dev": "next dev",
    "prebuild": "node scripts/generate-notes.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "notes:generate": "node scripts/generate-notes.mjs",
    "deploy": "npm run notes:generate && opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "upload": "npm run notes:generate && opennextjs-cloudflare build && opennextjs-cloudflare upload",
    "preview": "npm run notes:generate && opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv ./cloudflare-env.d.ts",
    "notes:check": "node scripts/generate-notes.mjs"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "^1.19.9",
    "next": "16.2.11",
    "react": "^19.1.7",
    "react-dom": "^19.1.7",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20.19.43",
    "@types/react": "^19.1.7",
    "@types/react-dom": "^19.1.7",
    "eslint": "^9",
    "eslint-config-next": "16.2.11",
    "tailwindcss": "^4",
    "typescript": "^5.7.4",
    "wrangler": "^4.115.0"
  }
}
